{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/join/:path*",
      "destination": "https://ikausa-app.vercel.app/join/:path*",
      "permanent": false
    },
    {
      "source": "/roll/:path*",
      "destination": "https://ikausa-app.vercel.app/roll/:path*",
      "permanent": false
    },
    {
      "source": "/camera/:path*",
      "destination": "https://ikausa-app.vercel.app/camera/:path*",
      "permanent": false
    },
    {
      "source": "/developing/:path*",
      "destination": "https://ikausa-app.vercel.app/developing/:path*",
      "permanent": false
    },
    {
      "source": "/host/:path*",
      "destination": "https://ikausa-app.vercel.app/host/:path*",
      "permanent": false
    },
    {
      "source": "/studio",
      "destination": "https://ikausa-app.vercel.app/studio",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "https://ikausa-app.vercel.app/studio/:path*",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "https://ikausa-app.vercel.app/sign-in",
      "permanent": false
    },
    {
      "source": "/onboarding",
      "destination": "https://ikausa-app.vercel.app/onboarding",
      "permanent": false
    },
    {
      "source": "/auth/:path*",
      "destination": "https://ikausa-app.vercel.app/auth/:path*",
      "permanent": false
    },
    {
      "source": "/profile",
      "destination": "https://ikausa-app.vercel.app/profile",
      "permanent": false
    },
    {
      "source": "/create/:path*",
      "destination": "https://ikausa-app.vercel.app/create/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
