{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/join/[code]"
    },
    {
      "source": "/roll/:id",
      "destination": "/roll/[id]"
    },
    {
      "source": "/camera/:id",
      "destination": "/camera/[id]"
    },
    {
      "source": "/developing/:id",
      "destination": "/developing/[id]"
    },
    {
      "source": "/host/:token",
      "destination": "/host/[token]"
    },
    {
      "source": "/studio/invite/:token",
      "destination": "/studio/invite/[token]"
    },
    {
      "source": "/studio/events/:id/print",
      "destination": "/studio/events/[id]/print"
    },
    {
      "source": "/studio/events/:id",
      "destination": "/studio/events/[id]"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
