{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/join/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|meta-externalagent|Facebot|Twitterbot|WhatsApp|Slackbot|Discordbot|TelegramBot|LinkedInBot|Pinterest|SkypeUriPreview|Viber|redditbot|Applebot|Googlebot|bingbot|Embedly|Iframely|vkShare|KAKAOTALK|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/join-preview?code=:code"
    },
    {
      "source": "/join/:code",
      "destination": "/join/[code]"
    },
    {
      "source": "/roll/:id",
      "destination": "/roll/[id]"
    },
    {
      "source": "/camera/:id",
      "destination": "/camera/[id]"
    },
    {
      "source": "/developing/:id",
      "destination": "/developing/[id]"
    },
    {
      "source": "/host/:token",
      "destination": "/host/[token]"
    },
    {
      "source": "/studio/invite/:token",
      "destination": "/studio/invite/[token]"
    },
    {
      "source": "/studio/events/:id/print",
      "destination": "/studio/events/[id]/print"
    },
    {
      "source": "/studio/events/:id",
      "destination": "/studio/events/[id]"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/studio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
