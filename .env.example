# Copy to .env and fill in from Supabase dashboard → Project Settings → API Keys.
# The publishable key is safe to ship in the app; never put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: public https base for invite links (needs universal/app links set up).
# Leave unset to use the app's own scheme (ikausa://join/CODE).
# EXPO_PUBLIC_INVITE_BASE_URL=https://example.com

# RevenueCat public SDK keys (Project settings → API keys). Paid passes are
# hidden until these are set; purchases need a development build.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# GCash / Maya payments on the web (confirmed by hand in Studio → Admin).
# URL of your GCash "Receive money" QR image. /gcash-qr.jpg serves public/gcash-qr.jpg.
# Not under public/.well-known: vercel.json serves that folder as JSON. The web defaults to
# /gcash-qr.jpg when unset; native builds hide GCash until it is set.
# EXPO_PUBLIC_GCASH_QR_URL=…
# EXPO_PUBLIC_GCASH_ACCOUNT_NAME=…
