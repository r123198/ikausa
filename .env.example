# Copy to .env and fill in from Supabase dashboard → Project Settings → API Keys.
# The publishable key is safe to ship in the app; never put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: public https base for invite links (needs universal/app links set up).
# Leave unset to use the app's own scheme (ikausa://join/CODE).
# EXPO_PUBLIC_INVITE_BASE_URL=https://example.com
